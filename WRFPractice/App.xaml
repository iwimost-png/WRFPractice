<Application x:Class="WRFPractice.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WRFPractice.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/ChatStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:RoleToHorizontalAlignmentConverter x:Key="RoleToAlignmentConverter" />
            <converters:RoleToBubbleBackgroundConverter x:Key="RoleToBgConverter" />
            <converters:RoleToForegroundConverter x:Key="RoleToFgConverter" />
            <converters:RoleToBorderBrushConverter x:Key="RoleToBorderConverter" />
            <converters:RoleToAvatarConverter x:Key="RoleToAvatarConverter" />
            <converters:RoleToSenderNameConverter x:Key="RoleToNameConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
