<Window x:Class="WRFPractice.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:WRFPractice.Models"
        mc:Ignorable="d"
        Title="AI 設定"
        Height="560"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI, Yu Gothic UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="AI 接続・動作設定"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <!-- Provider Selector -->
                <TextBlock Text="利用するAIプロバイダー"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding AvailableProviders}"
                          SelectedItem="{Binding SelectedProvider}"
                          Padding="8,6"
                          Margin="0,0,0,16" />

                <!-- OpenAI Section -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="OpenAI 設定"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />
                        
                        <TextBlock Text="API Key:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding OpenAiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernChatTextBox}"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="モデル名 (例: gpt-4o, gpt-4o-mini):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernChatTextBox}" />
                    </StackPanel>
                </Border>

                <!-- Gemini Section -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Google Gemini 設定"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="API Key:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernChatTextBox}"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="モデル名 (例: gemini-1.5-flash):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernChatTextBox}" />
                    </StackPanel>
                </Border>

                <!-- Ollama / Custom Section -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ローカル / Ollama 設定"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="エンドポイントURL:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CustomEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernChatTextBox}"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="モデル名 (例: llama3, mistral):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CustomModel, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernChatTextBox}" />
                    </StackPanel>
                </Border>

                <!-- System Prompt -->
                <TextBlock Text="システムプロンプト (AIへの指示)"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernChatTextBox}"
                         AcceptsReturn="True"
                         MinHeight="60"
                         MaxHeight="100"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,14" />

                <!-- Temperature -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Temperature (創造性):"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Temperature, StringFormat={}{0:F2}}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
                <Slider Minimum="0.0"
                        Maximum="1.0"
                        SmallChange="0.05"
                        LargeChange="0.1"
                        Value="{Binding Temperature}"
                        Margin="0,0,0,16" />
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル"
                        Style="{StaticResource ModernGhostButton}"
                        Command="{Binding CancelCommand}"
                        Width="90"
                        Margin="0,0,10,0" />
                <Button Content="保存"
                        Style="{StaticResource ModernPrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Width="90" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
